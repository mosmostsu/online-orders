{
  "manifest_version": 3,
  "name": "MVP Stock Sync",
  "description": "อัปเดตคลังร้าน Shopee MVP (mvp.sport2023) จาก ST ทุกวัน 18:00 หรือกดเอง ผ่าน Mass Update ของ Seller Center",
  "version": "1.0.0",
  "permissions": ["alarms", "storage", "scripting", "tabs"],
  "host_permissions": [
    "https://seller.shopee.co.th/*",
    "https://order-sync-solid.netlify.app/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "MVP Stock Sync" }
}
