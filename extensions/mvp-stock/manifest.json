{
  "manifest_version": 3,
  "name": "MVP Stock Sync",
  "description": "อัปเดตคลังร้าน Shopee MVP (mvp.sport2023) จาก ST + โคลนสินค้าจาก TikTok MVP (สั่งจากหน้า /compare) ผ่าน Seller Center",
  "version": "1.1.0",
  "permissions": [
    "alarms",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://seller.shopee.co.th/*",
    "https://order-sync-solid.netlify.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MVP Stock Sync"
  },
  "content_scripts": [
    {
      "matches": [
        "https://order-sync-solid.netlify.app/*"
      ],
      "js": [
        "content-bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}