# --- Supabase (project ใหม่ของ order-sync) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...            # service_role key — ใช้ฝั่ง server เท่านั้น ห้ามขึ้นหน้าเว็บ

# --- TikTok Shop (Partner app) ---
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_API_BASE=https://open-api.tiktokglobalshop.com
TIKTOK_AUTH_BASE=https://auth.tiktok-shops.com

# ปลายทางที่ TikTok เด้งกลับหลังกดอนุญาตร้าน (ต้องตรงกับที่ตั้งใน Partner Center)
TIKTOK_REDIRECT_URI=http://localhost:3000/api/auth/tiktok

# --- ป้องกันคนอื่นยิง /api/sync มั่ว ---
SYNC_SECRET=ตั้งอะไรก็ได้ยาวๆ

# --- Shopee (แอปใหม่ของเราเอง คนละตัวกับที่ Colab ใช้) ---
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_API_BASE=https://partner.shopeemobile.com

# --- หน้า /video (อ่านชีทคลิป TikTok อย่างเดียว) ---
# service account ที่ได้รับแชร์ชีทแบบ Viewer · ตั้งใน Netlify แบบธรรมดา (ห้าม secret) แล้ว Trigger deploy ใหม่
GOOGLE_SA_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
# ไม่บังคับ — ค่าเริ่มต้นคือชีทคลิปปัจจุบัน
VIDEO_SHEET_ID=

# --- TikTok Display API (ดึงคลิปของช่อง Solid/Meta — คนละแอปกับ TikTok Shop ข้างบน) ---
# จากหน้าแอปที่ developers.tiktok.com · ตั้งใน Netlify แบบธรรมดา (ห้าม secret) แล้ว Trigger deploy ใหม่
TIKTOK_DISPLAY_CLIENT_KEY=
TIKTOK_DISPLAY_CLIENT_SECRET=
# ไม่บังคับ: ต้องตรงกับ Redirect URI ที่ลงทะเบียนไว้ในแอป · scope ต้องตรงกับที่แอปได้รับ (ค่าเริ่มต้น video.list)
TIKTOK_DISPLAY_REDIRECT_URI=https://order-sync-solid.netlify.app/api/auth/tiktok-display
TIKTOK_DISPLAY_SCOPE=video.list
