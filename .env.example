# --- Supabase (project ใหม่ของ order-sync) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...            # service_role key — ใช้ฝั่ง server เท่านั้น ห้ามขึ้นหน้าเว็บ

# --- TikTok Shop (Partner app) ---
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_API_BASE=https://open-api.tiktokglobalshop.com
TIKTOK_AUTH_BASE=https://auth.tiktok-shops.com

# ปลายทางที่ TikTok เด้งกลับหลังกดอนุญาตร้าน (ต้องตรงกับที่ตั้งใน Partner Center)
TIKTOK_REDIRECT_URI=http://localhost:3000/api/auth/tiktok

# --- ป้องกันคนอื่นยิง /api/sync มั่ว ---
SYNC_SECRET=ตั้งอะไรก็ได้ยาวๆ

# --- Shopee (แอปใหม่ของเราเอง คนละตัวกับที่ Colab ใช้) ---
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_API_BASE=https://partner.shopeemobile.com

# --- TikTok ร้านที่ใช้แอปของตัวเอง (ไม่บังคับ) ---
# ตั้งชื่อแอปเป็นตัวพิมพ์ใหญ่ต่อท้าย เช่น MVP แล้วระบบจะผูกร้านกับแอปนี้เองตอนกดอนุญาต
# เปิด /api/auth/tiktok?shop=MVP&app=MVP (ต้องมี TIKTOK_SERVICE_ID_MVP) หรือกดอนุญาตจากลิงก์ของแอปนั้นแล้วเด้งมา /api/auth/tiktok?shop=MVP
# ตั้งใน Netlify แล้วต้อง Trigger deploy ใหม่ และห้ามตั้งแบบ secret (ฟังก์ชันอ่านไม่เห็น)
TIKTOK_APP_KEY_MVP=
TIKTOK_APP_SECRET_MVP=
TIKTOK_SERVICE_ID_MVP=
