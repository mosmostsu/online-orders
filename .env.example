# --- Supabase (project ใหม่ของ order-sync) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...            # service_role key — ใช้ฝั่ง server เท่านั้น ห้ามขึ้นหน้าเว็บ

# --- TikTok Shop (Partner app) ---
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_API_BASE=https://open-api.tiktokglobalshop.com
TIKTOK_AUTH_BASE=https://auth.tiktok-shops.com

# ปลายทางที่ TikTok เด้งกลับหลังกดอนุญาตร้าน (ต้องตรงกับที่ตั้งใน Partner Center)
TIKTOK_REDIRECT_URI=http://localhost:3000/api/auth/tiktok

# --- ป้องกันคนอื่นยิง /api/sync มั่ว ---
SYNC_SECRET=ตั้งอะไรก็ได้ยาวๆ
