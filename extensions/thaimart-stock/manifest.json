{
  "manifest_version": 3,
  "name": "Thaimart Stock Sync",
  "description": "อัปเดตคลังร้าน Solid Sports บน Thaimart จาก ST + โคลนสินค้าจาก TikTok SOLID (สั่งจากหน้า /compare) ผ่านหน้า Seller Center ที่ล็อกอินค้างไว้",
  "version": "1.1.1",
  "permissions": [
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://seller.thaimart.com/*",
    "https://order-sync-solid.netlify.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Thaimart Stock Sync"
  },
  "content_scripts": [
    {
      "matches": [
        "https://order-sync-solid.netlify.app/*"
      ],
      "js": [
        "content-bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}